FROM maven:latest AS deps

WORKDIR /app

RUN apt update && apt install -y --no-install-recommends entr && rm -rf /var/lib/apt/lists/*

COPY pom.xml /bom/pom.xml
RUN mvn -f /bom/pom.xml install -N

COPY services/storage-service/.mvn .mvn
COPY services/storage-service/mvnw services/storage-service/pom.xml ./
RUN ./mvnw -T 4 dependency:go-offline

COPY services/storage-service/src ./src
ENV _JAVA_OPTIONS="-XX:MaxRAMPercentage=50.0"
CMD ["sh", "-lc", "find src pom.xml | entr -rn ./mvnw spring-boot:run"]
